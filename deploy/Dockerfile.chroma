# ChromaDB + Embedding 常駐服務（向量檢索 + 語義搜尋用）
FROM python:3.11-slim

WORKDIR /app

COPY deploy/chroma-requirements.txt ./
RUN pip install --no-cache-dir -r chroma-requirements.txt

COPY chroma_service.py ./

# fastembed 模型快取目錄（首次執行會下載 jina-embeddings-v2-base-zh，約幾百 MB）
ENV HF_HOME=/app/hf_cache

EXPOSE 7707

CMD ["python", "-m", "uvicorn", "chroma_service:app", "--host", "0.0.0.0", "--port", "7707"]
