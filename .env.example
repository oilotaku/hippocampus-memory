# ═══════════════════════════════════════════════════════
# Memory Constellations — 环境变量模板
# 复制为 .env 后填入实际值
# ═══════════════════════════════════════════════════════

# ── 必填 ──
# 数据库加密密钥（64位hex，用 `openssl rand -hex 32` 生成）
SANCTUARY_ENCRYPTION_KEY=

# Session 密钥（64位随机hex）
SESSION_SECRET=

# 登录密码（明文，启动时会自动 bcrypt 哈希）
LOGIN_PASSWORD=

# LLM API Key（至少配一个）
API_KEY=

# ── LLM 渠道（至少配一个）──
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ── 可选 ──
# Jina Embedding API Key（默认使用本地 fastembed，不填则自动下载模型）
# JINA_API_KEY=

# 出站代理（国内访问 Google/OpenRouter API 用）
# HTTP_PROXY=http://127.0.0.1:7890

# 端口（默认 3000）
# PORT=3000

# ── 加密金鑰輪替（選填）──
# 新密文寫入的金鑰代號，預設 k1（限英數、底線、連字號，1～16 字）
# SANCTUARY_ENCRYPTION_KEY_ID=k1
# 輪替後仍需解密舊資料時，列出舊金鑰：kid=64位hex,kid=64位hex
# SANCTUARY_ENCRYPTION_KEYS_OLD=

# ── 記憶本體靜態加密（選填）──
# on（預設）：碎片內容/原話、敘事標題/內容、星座 facts/近況/判斷/概述 以 AES-GCM 加密，
#            全文檢索改用金鑰衍生的盲索引；off：明文（與舊版相同）。切換後下次啟動自動轉換。
# 換金鑰：設好新的 SANCTUARY_ENCRYPTION_KEY/KEY_ID 與 SANCTUARY_ENCRYPTION_KEYS_OLD 後，
#         先跑 node scripts/rotate_memory_keys.js --dry-run 再正式執行。
# MEMORY_ENCRYPTION=on

# ── 本機模型（Ollama）──
# SSRF 防護預設只允許 HTTPS 且擋私有位址；本機端點要逐一明確放行（完整 origin，逗號分隔）
# LLM_ENDPOINT_ALLOWLIST=http://127.0.0.1:11434
# 請求逾時（毫秒）；未設時本機端點 5 分鐘、雲端 30 秒
# LLM_REQUEST_TIMEOUT_MS=

# ── 其他（選填）──
# 資料庫路徑
# DB_PATH=./sanctuary.db
# ChromaDB 位址（向量檢索通道；未啟動時自動降級為全文＋實體）
# CHROMA_URL=http://127.0.0.1:7707
